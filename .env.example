# Required for live search and discovery (server only)
TMDB_API_READ_ACCESS_TOKEN=
# Optional: real IMDb ratings, never substituted with TMDB
OMDB_API_KEY=
# Optional managed Neon Auth + owner-scoped sync (server only)
DATABASE_URL=
# The Neon/Vercel integration can provide DATABASE_NEON_AUTH_BASE_URL instead.
NEON_AUTH_BASE_URL=
# Generate a random 32-byte secret; keep the same value across app deployments.
NEON_AUTH_COOKIE_SECRET=
